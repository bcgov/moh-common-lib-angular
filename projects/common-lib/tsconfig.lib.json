{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  },
  "exclude": ["**/*.spec.ts"],
  "include": [
    "../../src/public-api.ts",
    "../../src/lib/**/*.ts",
    "../../src/helpers/**/*.ts"
  ]
}
